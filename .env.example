# ===== 必填 =====
# 数据工作区默认是项目目录下的 workspace/；只有需要自定义位置时才取消注释。
# WORKSPACE_DIR=/absolute/path/to/taste-trainer/workspace

# OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o

# ===== 可选 =====
# 视觉模型（视频分析用）。不填则回退到 LLM_MODEL
# LLM_VISION_MODEL=gpt-4o

# API 服务端口
API_PORT=8421

# 认证数据库（默认 WORKSPACE_DIR/auth.sqlite3；只保存密码 hash 和 session hash）
# AUTH_DB_PATH=/srv/video-trainer/auth.sqlite3
# SESSION_TTL_SECONDS=2592000

# FastAPI → provider-service 的本机 HMAC 通道。必须使用随机高强度值。
PROVIDER_INTERNAL_SECRET=replace-with-a-random-32-byte-secret
PROVIDER_SERVICE_URL=http://127.0.0.1:8765

# Provider service（只监听 loopback；API key 用独立 32-byte key 加密落盘）
PROVIDER_PORT=8765
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# PROVIDER_DATA_DIR=/srv/video-trainer/provider-data
# 用 `openssl rand -base64 32` 生成，不要提交到 git 或放进 workspace。
PROVIDER_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# 旧单用户 providers.json 的一次性迁移（停服务后临时设置，成功后删除这三项）
# PROVIDER_LEGACY_CONFIG_PATH=/srv/video-trainer/service/workspace/.a2h/providers.json
# PROVIDER_MIGRATION_USER_ID=<wj 的 UUID>
# PROVIDER_DELETE_LEGACY=true

# 仅本地开发时允许 http provider；公网部署保持 false。
# ALLOW_INSECURE_PROVIDER_HTTP=true
# 仅本地 fake/局域网 endpoint 调试时开启；公网部署绝不能开启。
# ALLOW_PRIVATE_PROVIDER_HOSTS=true

# A2H 不再作为公网共享 viewer；用户训练内容只从认证后的 dashboard 读取。

# ffmpeg/ffprobe 路径（默认可执行文件名）
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# 资源保护
# MAX_UPLOAD_MB=1024  # 同步调整 deploy/nginx.conf.example 的 client_max_body_size
# MAX_VIDEO_SECONDS=1800
