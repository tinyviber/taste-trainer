# ===== 必填 =====
# 数据工作区默认是项目目录下的 workspace/；只有需要自定义位置时才取消注释。
# WORKSPACE_DIR=/absolute/path/to/taste-trainer/workspace

# OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o

# ===== 可选 =====
# 视觉模型（视频分析用）。不填则回退到 LLM_MODEL
# LLM_VISION_MODEL=gpt-4o

# API 服务端口
API_PORT=8421

# Provider service（React 的 Providers 页面使用；与 API_TOKEN 共用鉴权）
PROVIDER_PORT=8765
WEB_ORIGIN=http://localhost:5173
# 默认写到 workspace/.a2h/providers.json，权限为 0600
# PROVIDER_CONFIG_PATH=/srv/video-trainer/service/workspace/.a2h/providers.json

# A2H 深度浏览地址（可选；React 主流程会直接展示题目/评分/revision）
# 生产环境请改成浏览器可访问的 HTTPS 地址；默认 localhost 只适合本机开发。
A2H_URL=http://localhost:8420

# 简单鉴权：设置后所有 /api/* 和 provider API 需要 X-Token 头或 ?token= 参数。
# 本地 Vite 开发可打开 http://127.0.0.1:5173/?token=...；前端会带 header 并移除 URL 中的 token。
# API_TOKEN=

# ffmpeg/ffprobe 路径（默认可执行文件名）
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# 资源保护
# MAX_UPLOAD_MB=1024  # 同步调整 deploy/nginx.conf.example 的 client_max_body_size
# MAX_VIDEO_SECONDS=1800
