# ===== 必填 =====
# 数据工作区（workspace）绝对路径：videos/ runs/ analyses/ exercises/ 所在目录
WORKSPACE_DIR=/srv/video-trainer/workspace

# OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o

# ===== 可选 =====
# 视觉模型（视频分析用）。不填则回退到 LLM_MODEL
# LLM_VISION_MODEL=gpt-4o

# API 服务端口
API_PORT=8421

# A2H 视图地址（展示在首页的链接，只用于 UI 显示）
A2H_URL=http://localhost:8420

# 简单鉴权：设置后所有 /api/* 需要 X-Token 头或 ?token= 参数
# API_TOKEN=

# ffmpeg/ffprobe 路径（默认可执行文件名）
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# 资源保护
# MAX_UPLOAD_MB=1024
# MAX_VIDEO_SECONDS=1800
