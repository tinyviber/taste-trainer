#!/usr/bin/env bash
# 把本地数据工作区同步到 VPS（数据不进 git，靠这个脚本搬运）。
# 用法：VPS=user@host ./rsync-data.sh
set -euo pipefail

VPS="${VPS:?set VPS=user@host}"
LOCAL_WS="/Users/wj/Downloads/视频脚本分析"
REMOTE_WS="/srv/video-trainer/service/workspace"

# 只同步数据，排除 service/ 代码（代码走 git 部署）和可再生的大文件
rsync -avz --progress \
  --exclude 'service/' \
  --exclude 'runs/' \
  --exclude 'videos/inbox/' \
  --exclude '.a2h/providers.json' \
  --exclude '.DS_Store' \
  "$LOCAL_WS/" "$VPS:$REMOTE_WS/"

echo "完成。videos/ analyses/ exercises/ *.md 已同步；provider API key 不通过 rsync，旧 workspace 需按迁移脚本处理。"
