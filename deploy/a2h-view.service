[Unit]
Description=a2h viewer for video-script-trainer workspace
After=network.target

[Service]
WorkingDirectory=/srv/video-trainer/workspace
ExecStart=/usr/local/bin/a2h render /srv/video-trainer/workspace --watch --port 8420
Restart=on-failure
RestartSec=3
User=videotrainer
Group=videotrainer

[Install]
WantedBy=multi-user.target
