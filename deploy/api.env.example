# Copy to /etc/taste-trainer/api.env and chmod 0600.
WORKSPACE_DIR=/srv/video-trainer/service/workspace
TRAINING_ASSETS_DIR=/srv/video-trainer/service/training-assets
AUTH_DB_PATH=/srv/video-trainer/service/workspace/auth.sqlite3
API_PORT=8421
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o
WEB_ORIGINS=https://your-domain.example
PROVIDER_SERVICE_URL=http://127.0.0.1:8765
PROVIDER_INTERNAL_SECRET=replace-with-random-secret
MAX_UPLOAD_MB=1024
