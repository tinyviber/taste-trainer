# Copy to /etc/taste-trainer/provider.env and chmod 0600.
PROVIDER_PORT=8765
PROVIDER_DATA_DIR=/srv/video-trainer/provider-data
PROVIDER_ENCRYPTION_KEY=replace-with-base64-32-byte-key
PROVIDER_INTERNAL_SECRET=replace-with-random-secret
