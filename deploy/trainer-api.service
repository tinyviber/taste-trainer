[Unit]
Description=Taste Trainer authenticated API
After=network.target

[Service]
WorkingDirectory=/srv/video-trainer/service
EnvironmentFile=/etc/taste-trainer/api.env
ExecStart=/srv/video-trainer/service/.venv/bin/python -m uvicorn app.api:app --host 127.0.0.1 --port 8421 --workers 1
Restart=on-failure
RestartSec=3
User=videotrainer-api
Group=videotrainer-api
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/video-trainer/workspace

[Install]
WantedBy=multi-user.target
